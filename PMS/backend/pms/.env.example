# Bu dosya şablondur. Kopyala: backend/pms/.env  — gerçek değerleri SADECE .env'e yaz, asla commit'leme.

# --- Django ---
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
# DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com
# DJANGO_BEHIND_HTTPS_PROXY=False
# Tanıtım sitesi (Roomy) için paylaşılan anahtar; Roomy'de PMS_API_TOKEN ile aynı olmalı.
# Üret: python -c "import secrets; print(secrets.token_urlsafe(48))"
PUBLIC_API_KEY=
# PUBLIC_API_THROTTLE_RATE=300/minute
# WEBHOOK_THROTTLE_RATE=120/minute

# --- PostgreSQL ---
DATABASE_NAME=pms_db
DATABASE_USER=postgres
DATABASE_PASSWORD=
DATABASE_HOST=localhost
DATABASE_PORT=5432

# --- Redis / Celery ---
# Lokal: redis://localhost:6379/0 (docker compose'da otomatik redis://redis:6379/0 kullanılır)
REDIS_URL=redis://localhost:6379/0

# --- Ev varsayılanları ---
PROPERTY_TIMEZONE=Europe/Istanbul
DEFAULT_CHECKIN_TIME=15:00
DEFAULT_CHECKOUT_TIME=11:00
PROPERTY_CURRENCY=TRY
# Hafta sonu fiyatı uygulanan geceler (0=Pzt ... 6=Paz). Varsayılan Cuma+Cumartesi.
WEEKEND_NIGHTS=4,5

# --- Finans ---
# Kanal komisyon bildirmezse kullanılan varsayılan oranlar (%).
CHANNEL_COMMISSION_AIRBNB=15.5
CHANNEL_COMMISSION_BOOKING=15
CHANNEL_COMMISSION_OTHER=0

# --- Beds24 API V2 ---
# Beds24 refresh token (kullanıldıkça süresiz; 30 gün kullanılmazsa düşer). GİZLİ.
BEDS24_REFRESH_TOKEN=
BEDS24_API_BASE=https://beds24.com/api/v2
# Webhook URL'sindeki gizli parça. Uzun rastgele bir string. GİZLİ.
# Üret: python -c "import secrets; print(secrets.token_urlsafe(48))"
BEDS24_WEBHOOK_SECRET=
# Dışarıdan erişilebilen backend adresi (ngrok / Cloudflare Tunnel / domain).
# Doluysa sync sırasında webhook URL'si Beds24'e API ile kaydedilir.
PUBLIC_BASE_URL=

# --- E-posta (Inbox'tan direkt rezervasyon misafirine cevap; opsiyonel) ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
# SMTP şifresi / uygulama şifresi. GİZLİ.
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=
